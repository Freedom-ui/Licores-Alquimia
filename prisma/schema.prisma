// Modelo de datos de Licores Alquimia. Espeja los tipos de cada sección
// (app/(dashboard)/*/data.ts); la conversión fila ↔ tipo está en
// app/(dashboard)/_datos/repositorio.ts.
//
// Convenciones:
// - Fechas como texto "YYYY-MM-DD" (igual que en la app: se comparan como
//   texto y no hay corrimientos por zona horaria).
// - Cantidades y montos como Float (hay litros y kilos con decimales).
// - Los ids los asigna la lógica de la app (son números de negocio: N° de OP,
//   N° de orden), por eso se insertan explícitos.
// - Los movimientos de kardex se numeran dentro de su lote / materia prima
//   (clave compuesta), igual que en pantalla.
// - origen*Id en los movimientos son marcas de qué los generó (venta, orden,
//   compra) para actualizarlos o borrarlos en cascada; no son FK.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ── Acceso (cuenta única) ────────────────────────────────────
// La app la usa una sola persona en una sola PC: el primer arranque crea la
// cuenta y no hay registro ni roles. La lógica está en lib/auth/.

model Usuario {
  id                     Int       @id @default(autoincrement())
  username               String    @unique
  passwordHash           String
  // Código para recuperar usuario/contraseña (bcrypt). Null = todavía no se
  // generó (se genera al entrar).
  codigoRecuperacionHash String?
  // El código en texto plano solo mientras no confirmó "Ya lo guardé": así
  // recargar la pantalla del código no lo pierde. Después se borra.
  codigoPendiente        String?
  createdAt              DateTime  @default(now())
  actualizadoEn          DateTime  @default(now()) @updatedAt
  sesiones               Sesion[]
}

// Sesión iniciada: la cookie lleva un token al azar y acá se guarda solo su
// SHA-256 (una copia de la base no sirve para entrar).
model Sesion {
  id        String   @id
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  creadaEn  DateTime @default(now())
  ultimoUso DateTime @default(now())

  @@index([usuarioId])
}

// Intentos fallidos de ingreso o de recuperación, para el bloqueo temporal.
// Se cuentan todos juntos (es una sola PC) y un ingreso correcto los borra.
model IntentoFallido {
  id    Int      @id @default(autoincrement())
  tipo  String // "login" | "recuperacion"
  fecha DateTime @default(now())

  @@index([fecha])
}

// ── Catálogos ────────────────────────────────────────────────
model Cliente {
  id                Int     @id @default(autoincrement())
  razonSocial       String
  apellidoNombre    String  @default("")
  condicionIva      String  @default("")
  cuit              String  @default("")
  telefono          String  @default("")
  email             String  @default("")
  domicilio         String  @default("")
  precioTradicional Float   @default(0)
  precioPremium     Float?

  operaciones Operacion[]
}

model Proveedor {
  id          Int     @id @default(autoincrement())
  razonSocial String
  contacto    String  @default("")
  producto    String  @default("")
  cuitCuil    String  @default("")
  email       String  @default("")
  telefono    String  @default("")
  cbu         String?
  alias       String?

  compras Compra[]
}

model MateriaPrima {
  id     Int    @id @default(autoincrement())
  nombre String
  /// Litros | Kilogramos | Unidades | Metros
  unidad String
  /// Se compra fresca para cada orden (cítricos, hierbas): sin alerta de reposición.
  compraPorOrden Boolean @default(false)

  compras    Compra[]
  inventario InventarioMateriaPrima[]
}

model Producto {
  id             Int    @id @default(autoincrement())
  nombre         String
  formato        String
  codigoBarras   String @default("")
  precioUnitario Float  @default(0)

  operaciones Operacion[]
  ordenes     OrdenProduccion[]
  lotes       LoteTerminado[]
}

/// Vendedores de las ventas (Operacion.vendedor guarda el nombre como texto).
model Vendedor {
  id     Int    @id @default(autoincrement())
  nombre String
}

// ── Ventas ───────────────────────────────────────────────────
model Operacion {
  id         Int      @id @default(autoincrement())
  fecha      String
  clienteId  Int
  cliente    Cliente  @relation(fields: [clienteId], references: [id])
  vendedor   String
  cantidad   Float
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])
  canal      String
  condicion  String
  pu         Float
  subTotal   Float

  @@index([fecha])
  @@index([clienteId])
  @@index([productoId])
}

// ── Compras (Libro de compras - Trazabilidad) ────────────────
model Compra {
  id                Int          @id @default(autoincrement())
  fecha             String
  materiaPrimaId    Int
  materiaPrima      MateriaPrima @relation(fields: [materiaPrimaId], references: [id])
  cantidad          Float
  costoUnitario     Float
  cantidadCascara   Float?
  /// Lote del proveedor ("" si no trae).
  lote              String       @default("")
  proveedorId       Int
  proveedor         Proveedor    @relation(fields: [proveedorId], references: [id])
  comprobanteForm   String       @default("")
  comprobanteTipo   String       @default("")
  comprobanteNumero String       @default("")
  /// MPR | MPA | CDNI | EFE
  medioPago         String

  insumos OrdenInsumo[]

  @@index([fecha])
  @@index([materiaPrimaId])
  @@index([proveedorId])
}

// ── Producción ───────────────────────────────────────────────
model OrdenProduccion {
  id                Int           @id @default(autoincrement())
  productoId        Int
  producto          Producto      @relation(fields: [productoId], references: [id])
  fechaMaceracion   String
  /// null = todavía macerando.
  fechaEmbotellado  String?
  responsable       String
  /// null = todavía sin estimar (solo mientras macera: al embotellar es obligatoria).
  cantidadProducida Float?
  costoTotal        Float

  insumos OrdenInsumo[]

  @@index([fechaMaceracion])
  @@index([productoId])
}

model OrdenInsumo {
  id            Int             @id @default(autoincrement())
  ordenId       Int
  orden         OrdenProduccion @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  /// Orden de la línea dentro de la orden de producción.
  posicion      Int
  /// Nombre de la materia prima (así lo guarda la orden; se renombra en cascada).
  materiaPrima  String
  cantidad      Float
  costoUnitario Float
  /// Compra del Libro de compras de la que sale (trazabilidad); null = stock sin compra.
  compraId      Int?
  compra        Compra?         @relation(fields: [compraId], references: [id])

  @@index([ordenId])
  @@index([compraId])
}

// ── Productos terminados (kardex por lote) ───────────────────
model LoteTerminado {
  id                Int       @id @default(autoincrement())
  lote              Int
  productoId        Int?
  productoRef       Producto? @relation(fields: [productoId], references: [id])
  /// Nombre y formato guardados (hay lotes históricos de productos que ya no están en el catálogo).
  producto          String
  formato           String
  existenciaInicial Float
  costoUnitario     Float
  fechaVencimiento  String?
  /// Orden de producción que generó el lote (marca, no FK).
  origenOrdenId     Int?

  movimientos MovimientoLote[]

  @@index([productoId])
  @@index([origenOrdenId])
}

model MovimientoLote {
  loteId             Int
  lote               LoteTerminado @relation(fields: [loteId], references: [id], onDelete: Cascade)
  id                 Int
  /// null = fila de existencia inicial.
  fecha              String?
  /// entrada | salida
  tipo               String
  cantidad           Float
  puEntrada          Float?
  cantidadSecundaria Float?
  origenOperacionId  Int?
  origenOrdenId      Int?
  origenCompraId     Int?

  @@id([loteId, id])
  @@index([origenOperacionId])
}

// ── Inventario de materia prima (kardex) ─────────────────────
model InventarioMateriaPrima {
  id                Int          @id @default(autoincrement())
  materiaPrimaId    Int
  materiaPrima      MateriaPrima @relation(fields: [materiaPrimaId], references: [id])
  existenciaInicial Float
  costoUnitario     Float

  movimientos MovimientoInventario[]

  @@index([materiaPrimaId])
}

model MovimientoInventario {
  inventarioId       Int
  inventario         InventarioMateriaPrima @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  id                 Int
  fecha              String?
  tipo               String
  cantidad           Float
  puEntrada          Float?
  cantidadSecundaria Float?
  origenOperacionId  Int?
  origenOrdenId      Int?
  origenCompraId     Int?

  @@id([inventarioId, id])
  @@index([origenCompraId])
  @@index([origenOrdenId])
}

// ── Historial de subidas de planillas (Importar planilla) ────
// Una fila por cada planilla (o grupo de .csv) que se subió: se crea al
// analizarla (o al fallar la lectura) y se actualiza si se importa. No es
// dato del negocio: la importación no la toca.
model SubidaPlanilla {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @default(now())
  actualizada DateTime @updatedAt
  usuario     String
  /// Nombre del archivo (o de los .csv, separados por coma).
  archivo     String
  /// revision | importada | sinNovedades | fallo | noLeida
  estado      String
  agregados   Int      @default(0)
  existentes  Int      @default(0)
  conError    Int      @default(0)
  avisos      Int      @default(0)
  /// Copia de seguridad hecha antes de importar (carpeta respaldos/).
  respaldo    String?
  /// Por qué no se pudo leer o importar.
  error       String?
  /// JSON con el detalle (DetalleSubida en _importar/historial.ts).
  detalle     String   @default("{}")

  @@index([fecha])
}
